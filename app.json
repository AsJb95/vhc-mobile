{
  "expo": {
    "name": "VHC Mobile",
    "slug": "vhc-mobile",
    "version": "1.4.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0a0f1e",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vhc.warehouse.mobile"
    },
    "android": {
      "package": "com.vhc.warehouse.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 20
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "3d37b26f-9bdb-4539-923b-31287a62e99d"
      }
    },
    "owner": "arun.s",
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "VHC Mobile needs access to your gallery to select printed medicine invoices.",
          "cameraPermission": "VHC Mobile needs camera access to scan printed medicine invoices."
        }
      ]
    ]
  }
}
