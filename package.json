{
  "name": "vhc-mobile",
  "version": "1.1.0",
  "main": "index.js",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.16",
    "@react-navigation/native": "^7.3.16",
    "@react-navigation/native-stack": "^7.18.8",
    "@supabase/supabase-js": "^2.112.3",
    "expo": "~57.0.18",
    "expo-font": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "moti": "0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "test": "jest",
    "doctor": "expo-doctor",
    "verify": "npm run lint && npm test && npx expo export --platform android --output-dir .expo-verify-export && node -e \"require('fs').rmSync('.expo-verify-export',{recursive:true,force:true})\""
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|moti|@supabase/.*))"
    ]
  },
  "private": true,
  "devDependencies": {
    "babel-preset-expo": "^57.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5"
  }
}
