# Copy to .env for local development. These are EXPO_PUBLIC_* values, inlined
# into the JS bundle at build time. The anon key is a *publishable* key — access
# control is enforced by Postgres Row-Level Security, so it is safe to ship.
#
# For EAS builds these same values live in eas.json -> build.<profile>.env
# (or set them as EAS project Environment Variables and remove them from eas.json).

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
